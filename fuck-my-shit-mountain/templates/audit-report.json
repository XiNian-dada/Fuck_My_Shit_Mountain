{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fuck My Shit Mountain Audit Report",
  "type": "object",
  "required": [
    "metadata",
    "executiveSummary",
    "scoreDashboard",
    "findingStatistics",
    "projectMap",
    "coverageMatrix",
    "topRisks",
    "detailedFindings",
    "dimensionSections",
    "fixOrder",
    "quickWins"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["project", "auditModes", "date", "reviewer", "commitHash"],
      "properties": {
        "project": {
          "type": "string",
          "description": "Project name",
          "minLength": 1
        },
        "auditModes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "full",
              "incremental",
              "architecture",
              "security",
              "stability",
              "performance",
              "testing",
              "maintainability",
              "design",
              "release",
              "documentation",
              "observability",
              "configuration",
              "data-integrity",
              "privacy",
              "accessibility",
              "supply-chain",
              "cost",
              "ai-safety",
              "fallback",
              "testing-authenticity",
              "type-safety",
              "frontend-state",
              "backend-api",
              "dependency-weight",
              "code-consistency",
              "comment-coverage",
              "concurrency"
            ],
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "date": {
          "type": "string",
          "format": "date",
          "minLength": 1
        },
        "reviewer": {
          "type": "string",
          "description": "AI model/version",
          "minLength": 1
        },
        "commitHash": {
          "type": ["string", "null"],
          "description": "Audited commit hash, or null outside a Git repository. Record dirty worktree state in scope."
        },
        "scope": {
          "type": "string",
          "description": "Audit scope if limited (optional)",
          "minLength": 1
        },
        "reportLanguage": {
          "type": "string",
          "description": "Language used in report",
          "minLength": 1
        }
      }
    },
    "executiveSummary": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": {
          "type": "string",
          "description": "2-3 paragraph summary of codebase condition",
          "minLength": 1
        }
      }
    },
    "scoreDashboard": {
      "type": "object",
      "required": ["dimensions", "overall"],
      "properties": {
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "score", "grade", "justification", "coverageConfidence"],
            "properties": {
              "name": {
                "type": "string",
                "enum": ["Security", "Stability", "Performance", "Testing", "Maintainability", "Design", "Release"],
                "minLength": 1
              },
              "score": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 10,
                "description": "Score 0.0-10.0, higher is better"
              },
              "grade": {
                "type": ["string", "null"],
                "enum": ["S", "A", "B", "C", "D", "F", null]
              },
              "justification": {
                "type": "string",
                "description": "One-sentence justification referencing strongest evidence",
                "minLength": 1
              },
              "coverageConfidence": {
                "type": "string",
                "enum": ["High", "Medium", "Low", "Not assessed"],
                "minLength": 1
              }
            }
          }
        },
        "overall": {
          "type": "object",
          "required": ["score", "grade"],
          "properties": {
            "score": {
              "type": ["number", "null"],
              "minimum": 0,
              "maximum": 10
            },
            "grade": {
              "type": ["string", "null"],
              "enum": ["S", "A", "B", "C", "D", "F", null]
            }
          }
        },
        "intelligentWeights": {
          "type": "object",
          "description": "Optional weights only when requested by the user; otherwise overall is an unweighted mean of assessed dimensions.",
          "properties": {
            "weights": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "reasoning": {
              "type": "string",
              "description": "Requested weighting policy and its rationale; normalize over assessed dimensions only.",
              "minLength": 1
            }
          },
          "required": ["weights", "reasoning"]
        }
      }
    },
    "findingStatistics": {
      "type": "object",
      "required": ["bySeverity", "total"],
      "properties": {
        "bySeverity": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["severity", "count", "confirmed", "suspected"],
            "properties": {
              "severity": {
                "type": "string",
                "enum": ["Critical", "High", "Medium", "Low", "Info"],
                "minLength": 1
              },
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "confirmed": {
                "type": "integer",
                "minimum": 0
              },
              "suspected": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "minItems": 5,
          "maxItems": 5
        },
        "total": {
          "type": "object",
          "required": ["count", "confirmed", "suspected"],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "confirmed": {
              "type": "integer",
              "minimum": 0
            },
            "suspected": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "projectMap": {
      "type": "object",
      "required": ["structure", "keyComponents", "riskAreas"],
      "properties": {
        "structure": {
          "type": "string",
          "description": "How the project is structured",
          "minLength": 1
        },
        "keyComponents": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Entry points, data flow, state ownership, persistence, external interfaces"
        },
        "riskAreas": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Areas most likely to contain risks"
        }
      }
    },
    "coverageMatrix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dimension", "coverage", "evidenceInspected", "exclusions"],
        "properties": {
          "dimension": {
            "type": "string",
            "minLength": 1
          },
          "coverage": {
            "type": "string",
            "enum": ["High", "Medium", "Low", "Not assessed"],
            "minLength": 1
          },
          "evidenceInspected": {
            "type": "string",
            "description": "Files, commands, patterns, runtime surfaces",
            "minLength": 1
          },
          "exclusions": {
            "type": "string",
            "description": "What was not inspected and why",
            "minLength": 1
          }
        }
      }
    },
    "topRisks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "severity", "summary", "findingId"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": ["Critical", "High", "Medium", "Low", "Info"],
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "description": "One-sentence summary",
            "minLength": 1
          },
          "findingId": {
            "type": "string",
            "description": "Reference to detailed finding",
            "minLength": 1
          }
        }
      },
      "minItems": 0,
      "maxItems": 15
    },
    "detailedFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "severity",
          "confidence",
          "category",
          "status",
          "affectedArea",
          "evidence",
          "failureScenario",
          "userVisibleImpact",
          "minimalFix",
          "regressionTestSuggestion",
          "estimatedEffort",
          "problem"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique finding identifier",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": ["Critical", "High", "Medium", "Low", "Info"],
            "minLength": 1
          },
          "confidence": {
            "type": "string",
            "enum": ["High", "Medium", "Low"],
            "minLength": 1
          },
          "category": {
            "type": "string",
            "description": "Primary dimension category",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["Confirmed", "Suspected"],
            "minLength": 1
          },
          "affectedArea": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "object",
            "required": ["file", "functionOrModule", "relevantBehavior"],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "lineNumbers": {
                "type": "string",
                "minLength": 1
              },
              "functionOrModule": {
                "type": "string",
                "minLength": 1
              },
              "relevantBehavior": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "failureTrigger": {
            "type": "string",
            "description": "What triggers this issue (optional)",
            "minLength": 1
          },
          "failureScenario": {
            "type": "string",
            "description": "Realistic failure scenario",
            "minLength": 1
          },
          "userVisibleImpact": {
            "type": "string",
            "description": "Why the issue matters: user-visible impact or concrete engineering cost.",
            "minLength": 1
          },
          "minimalFix": {
            "type": "string",
            "minLength": 1
          },
          "betterLongTermFix": {
            "type": "string",
            "description": "Optional better long-term solution",
            "minLength": 1
          },
          "regressionTestSuggestion": {
            "type": "string",
            "minLength": 1
          },
          "estimatedEffort": {
            "type": "string",
            "description": "e.g., '30 minutes', '2 hours', '1 day'",
            "minLength": 1
          },
          "problem": {
            "type": "string",
            "description": "Concrete problem explained by the evidence",
            "minLength": 1
          }
        }
      }
    },
    "dimensionSections": {
      "type": "object",
      "description": "One analysis per selected focused dimension, keyed by canonical mode ID; include Not assessed explanations.",
      "additionalProperties": {
        "type": "object",
        "required": ["summary"],
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "verifiedChecks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "fixOrder": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["priority", "findingId", "reason"],
        "properties": {
          "priority": {
            "type": "integer",
            "minimum": 1
          },
          "findingId": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "description": "Why this should be fixed in this order",
            "minLength": 1
          }
        }
      }
    },
    "quickWins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["findingId", "effort", "impact"],
        "properties": {
          "findingId": {
            "type": "string",
            "minLength": 1
          },
          "effort": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
